# Leave unset for local dev (uses Vite's proxy to http://localhost:4000).
# For production, set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://api.madamsaab.com/api/v1
VITE_API_URL=

# Razorpay public key id (safe to expose to the browser). The secret key
# stays server-side only, in the backend's .env.
VITE_RAZORPAY_KEY_ID=change_me
